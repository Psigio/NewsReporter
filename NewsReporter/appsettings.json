{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "TargetApi": {
        "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
        "TimeoutSeconds": 15,
        "MaxConcurrentRequests": 3,
        "MaxQueuedRequests": 512
    },
    "Caching": {
        "BestStoriesCacheExpirationSeconds": 60,
        "StorySummaryCacheExpirationSeconds": 300
    }
}